# --- DJANGO BACKEND ---
DJANGO_SECRET_KEY=generate-a-strong-random-key-64-characters-min
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1,nginx,jb-saniyapur.com,www.jb-saniyapur.com,185.202.239.199

# --- BASE DE DONNÉES POSTGRESQL ---
POSTGRES_DB=saniyapur
POSTGRES_USER=saniyapur_admin
POSTGRES_PASSWORD=generate-a-very-secure-password-here

# --- CORS & CSRF ---
CORS_ALLOWED_ORIGINS=http://jb-saniyapur.com,http://www.jb-saniyapur.com,https://jb-saniyapur.com,https://www.jb-saniyapur.com,http://185.202.239.199
DJANGO_CSRF_TRUSTED_ORIGINS=http://jb-saniyapur.com,http://www.jb-saniyapur.com,https://jb-saniyapur.com,https://www.jb-saniyapur.com,http://185.202.239.199
DJANGO_SECURE_SSL_REDIRECT=False

# --- FRONTEND NEXT.JS ---
# Utiliser /api si routé via Nginx sur le même domaine, ou l'URL complète si séparé
NEXT_PUBLIC_API_URL=/api

# --- NGINX ---
PORT_HTTP=80
